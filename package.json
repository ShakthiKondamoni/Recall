{
  "name": "recall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs web",
    "dev:web": "node scripts/dev.mjs web",
    "dev:api": "node scripts/dev.mjs api",
    "dev:desktop": "node scripts/dev.mjs desktop",
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/build.mjs web",
    "build:api": "node scripts/build.mjs api",
    "build:desktop": "node scripts/build.mjs desktop",
    "package:win": "corepack pnpm build && corepack pnpm --filter @recall/desktop package:win",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:api-native": "node scripts/build.mjs api && node scripts/test-api.mjs",
    "test:native": "node --test tests/native/*.test.mjs",
    "test:e2e": "playwright test tests/e2e",
    "test:desktop": "playwright test tests/desktop",
    "db:migrate": "node scripts/migrate.mjs",
    "check": "corepack pnpm typecheck && corepack pnpm lint && corepack pnpm test && corepack pnpm test:native && corepack pnpm test:api-native && corepack pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "@playwright/test": "1.51.1",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "@tailwindcss/vite": "4.0.14",
    "eslint": "9.22.0",
    "esbuild": "0.25.1",
    "globals": "16.0.0",
    "prettier": "3.5.3",
    "tailwindcss": "4.0.14",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.0",
    "vite": "6.1.0",
    "vitest": "3.0.8"
  }
}
